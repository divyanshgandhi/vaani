# API Gateway Configuration
PORT=8080
APP_ENV=development
LOG_LEVEL=debug

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SECOND=5
RATE_LIMIT_RESET_AFTER_SECONDS=60

# Firebase Configuration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CREDENTIALS_FILE=credentials/firebase-service-account.json
FIREBASE_USE_EMULATOR=false
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_FIRESTORE_EMULATOR_HOST=localhost:8080

# Service URLs (for local development)
ORPHEUS_SERVICE_URL=http://localhost:8081
BULBUL_ADAPTER_URL=http://localhost:8082
MEDIA_SERVICE_URL=http://localhost:8083

# For Docker Compose
# ORPHEUS_SERVICE_URL=http://orpheus-inference:8081
# BULBUL_ADAPTER_URL=http://bulbul-adapter:8082
# MEDIA_SERVICE_URL=http://media-service:8083
