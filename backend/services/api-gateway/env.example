# Application Configuration
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_FILE=./credentials/firebase-service-account.json
FIREBASE_USE_EMULATOR=false
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_FIRESTORE_EMULATOR_HOST=localhost:8080

# Service URLs
BULBUL_ADAPTER_URL=http://localhost:8082
ORPHEUS_SERVICE_URL=http://localhost:8081
MEDIA_SERVICE_URL=http://localhost:8083

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_SECOND=5
RATE_LIMIT_RESET_AFTER_SECONDS=60

# External API Keys (for production)
SARVAM_API_KEY=your-sarvam-api-key
WASABI_ACCESS_KEY=your-wasabi-access-key
WASABI_SECRET_KEY=your-wasabi-secret-key
WASABI_BUCKET=vaani-media-storage 